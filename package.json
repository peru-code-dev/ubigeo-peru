{
    "name": "@perucode/ubigeo-peru",
    "version": "1.0.0",
    "description": "SDK for Peruvian ubigeo data — zero dependencies",
    "repository": {
        "type": "git",
        "url": "https://github.com/peru-code-dev/ubigeo-peru"
    },
    "bugs": {
        "url": "https://github.com/peru-code-dev/ubigeo-peru/issues"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "prepublishOnly": "npm run build",
        "build": "tsup",
        "build:dev": "tsup --watch --sourcemap",
        "test": "vitest run",
        "dev": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check"
    },
    "devDependencies": {
        "@eslint/js": "^9.16.0",
        "@types/node": "^26.0.0",
        "eslint": "^9.16.0",
        "globals": "^15.13.0",
        "prettier": "^3.8.4",
        "tsup": "^8.3.0",
        "typescript": "^6.0.0",
        "typescript-eslint": "^8.18.0",
        "vitest": "^4.1.0"
    },
    "keywords": [
        "ubigeo",
        "peru",
        "inei",
        "districts",
        "provinces",
        "regions"
    ],
    "license": "MIT"
}
